generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  fixtures  Fixture[]
  materials Material[]
}

model Location {
  id        String     @id @default(uuid())
  name      String     @unique
  parentId  String?
  parent    Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[] @relation("LocationHierarchy")
  fixtures  Fixture[]
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Project {
  id        String          @id @default(uuid())
  name      String
  isActive  Boolean         @default(true)
  details   String?
  stocks    MaterialStock[]
  createdAt DateTime        @default(now())
}

model Fixture {
  id          String    @id @default(uuid())
  name        String
  description String?
  locationId  String
  categoryId  String?
  location    Location  @relation(fields: [locationId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Material {
  id            String          @id @default(uuid())
  name          String
  description   String?
  defaultLocId  String?
  categoryId    String?
  defaultLoc    Location?       @relation(fields: [defaultLocId], references: [id])
  category      Category?       @relation(fields: [categoryId], references: [id])
  stocks        MaterialStock[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model MaterialStock {
  id          String   @id @default(uuid())
  materialId  String
  quantity    Int
  status      String   // "DEPODA", "KULLANIMDA", "TUKETILDI"
  projectId   String?
  material    Material @relation(fields: [materialId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // örn: "LOCATION_UPDATE", "STOCK_USED"
  targetId    String   // ID (Material, Fixture vb.)
  targetType  String   // "MATERIAL", "FIXTURE", "PROJECT" vb.
  details     String?  // Değişimi açıklayan metin veya JSON
  createdAt   DateTime @default(now())
}
